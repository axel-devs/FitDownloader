{
  "name": "fitdownloader",
  "version": "0.2.1",
  "private": true,
  "description": "Development checks for the FitDownloader browser extension",
  "engines": {
    "node": ">=24.8.0 <25"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:coverage": "c8 --check-coverage node --test tests/*.test.cjs && node scripts/check-coverage.cjs",
    "test:browser": "playwright test",
    "test:browser:install": "node scripts/install-browser.cjs",
    "test:regressions": "node --test tests/regressions/*.test.cjs",
    "lint": "eslint background.js popup.js options.js tests scripts playwright.config.cjs eslint.config.cjs",
    "check:manifest": "node scripts/check-manifest.cjs",
    "check": "npm run lint && npm run check:manifest && npm run test:coverage"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "c8": "12.0.0",
    "eslint": "10.14.0",
    "jsdom": "26.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "glob": "14.0.2"
  },
  "c8": {
    "all": true,
    "include": [
      "*.js",
      "src/**/*.js"
    ],
    "exclude": [],
    "reporter": [
      "text",
      "html",
      "lcov",
      "json-summary"
    ],
    "lines": 85,
    "branches": 75,
    "functions": 95
  }
}
